<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Descargador de Videos</title>
  <style>
    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --text: #f8fafc;
      --accent-yt: #ff0000;
      --accent-fb: #1877f2;
      --accent-tk: #00f2fe;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 450px;
      background: var(--card-bg);
      border-radius: 20px;
      padding: 30px 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .screen {
      display: none;
      animation: fadeIn 0.4s ease-in-out forwards;
    }

    .screen.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Pantalla 1: Splash / Bienvenida */
    .rgb-text {
      font-size: 2rem;
      font-weight: 900;
      text-transform: uppercase;
      background: linear-gradient(90deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #8b00ff, #ff0000);
      background-size: 400%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: rgbGlow 6s linear infinite;
      margin-bottom: 30px;
    }

    @keyframes rgbGlow {
      0% { background-position: 0% 50%; }
      100% { background-position: 400% 50%; }
    }

    .btn-start {
      background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
      color: #000;
      font-weight: 800;
      font-size: 1.1rem;
      padding: 15px 40px;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      box-shadow: 0 0 15px rgba(0, 242, 254, 0.4);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-start:active {
      transform: scale(0.95);
    }

    /* Pantalla 2: Selección de plataforma */
    h2 {
      font-size: 1.5rem;
      margin-bottom: 25px;
    }

    .btn-platform {
      width: 100%;
      padding: 16px;
      margin: 10px 0;
      border: none;
      border-radius: 12px;
      font-size: 1.1rem;
      font-weight: bold;
      color: #fff;
      cursor: pointer;
      transition: transform 0.2s;
    }

    .btn-platform:active {
      transform: scale(0.98);
    }

    .btn-yt { background: var(--accent-yt); box-shadow: 0 4px 15px rgba(255, 0, 0, 0.3); }
    .btn-fb { background: var(--accent-fb); box-shadow: 0 4px 15px rgba(24, 119, 242, 0.3); }
    .btn-tk { background: #000; border: 1px solid #333; color: var(--accent-tk); box-shadow: 0 4px 15px rgba(0, 242, 254, 0.2); }

    /* Pantalla 3: Descarga */
    .input-box {
      width: 100%;
      padding: 14px;
      border: 2px solid #334155;
      background: #0f172a;
      border-radius: 10px;
      color: #fff;
      font-size: 1rem;
      margin-bottom: 15px;
      outline: none;
    }

    .input-box:focus {
      border-color: #38bdf8;
    }

    .format-selector {
      display: flex;
      gap: 10px;
      margin-bottom: 15px;
    }

    .btn-format {
      flex: 1;
      padding: 10px;
      background: #334155;
      border: none;
      border-radius: 8px;
      color: #fff;
      font-weight: bold;
      cursor: pointer;
    }

    .btn-format.active {
      background: #38bdf8;
      color: #0f172a;
    }

    .btn-download {
      width: 100%;
      padding: 15px;
      background: #22c55e;
      border: none;
      border-radius: 10px;
      color: #fff;
      font-weight: bold;
      font-size: 1rem;
      cursor: pointer;
    }

    .btn-back {
      background: transparent;
      border: none;
      color: #94a3b8;
      margin-top: 15px;
      cursor: pointer;
      text-decoration: underline;
    }

    #status {
      margin-top: 15px;
      font-size: 0.9rem;
      color: #38bdf8;
      min-height: 20px;
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- Screen 1: Splash RGB -->
    <div id="screen1" class="screen active">
      <div class="rgb-text">Powered by Gxrcia</div>
      <button class="btn-start" onclick="nextScreen('screen2')">EMPEZEMOS</button>
    </div>

    <!-- Screen 2: Menu Principal -->
    <div id="screen2" class="screen">
      <h2>¿Qué vamos a descargar?</h2>
      <button class="btn-platform btn-yt" onclick="openDownloader('youtube')">YouTube</button>
      <button class="btn-platform btn-fb" onclick="openDownloader('facebook')">Facebook</button>
      <button class="btn-platform btn-tk" onclick="openDownloader('tiktok')">TikTok</button>
    </div>

    <!-- Screen 3: Apartado de Descarga -->
    <div id="screen3" class="screen">
      <h2 id="platformTitle">Descargar</h2>
      
      <input type="url" id="videoUrl" class="input-box" placeholder="Pega la URL aquí..." autocomplete="off">
      
      <div id="opcionesFormato" class="format-selector" style="display: none;">
        <button id="btnMp4" class="btn-format active" onclick="setFormat('mp4')">MP4 (Video)</button>
        <button id="btnMp3" class="btn-format" onclick="setFormat('mp3')">MP3 (Audio)</button>
      </div>

      <button class="btn-download" onclick="procesarDescarga()">Iniciar Descarga</button>
      
      <div id="status"></div>
      
      <button class="btn-back" onclick="nextScreen('screen2')">← Volver al menú</button>
    </div>
  </div>

  <script>
    let plataformaActual = '';
    let formatoActual = 'mp4';

    function nextScreen(screenId) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      document.getElementById(screenId).classList.add('active');
      document.getElementById('status').innerText = '';
    }

    function openDownloader(platform) {
      plataformaActual = platform;
      formatoActual = 'mp4';
      
      const title = document.getElementById('platformTitle');
      const formatOptions = document.getElementById('opcionesFormato');
      const urlInput = document.getElementById('videoUrl');
      
      urlInput.value = '';
      title.innerText = 'Descargar de ' + platform.toUpperCase();

      if (platform === 'youtube') {
        formatOptions.style.display = 'flex';
        setFormat('mp4');
      } else {
        formatOptions.style.display = 'none';
      }

      nextScreen('screen3');
    }

    function setFormat(fmt) {
      formatoActual = fmt;
      document.getElementById('btnMp4').classList.toggle('active', fmt === 'mp4');
      document.getElementById('btnMp3').classList.toggle('active', fmt === 'mp3');
    }

    async function procesarDescarga() {
      const url = document.getElementById('videoUrl').value.trim();
      const statusDiv = document.getElementById('status');

      if (!url) {
        alert('Por favor, ingresa un enlace o URL válida.');
        return;
      }

      statusDiv.innerText = 'Procesando enlace...';

      const payload = {
        url: url,
        videoQuality: '720',
        isAudioOnly: (formatoActual === 'mp3')
      };

      try {
        const response = await fetch('https://api.cobalt.tools/api/json', {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (data.status === 'stream' || data.status === 'redirect') {
          statusDiv.innerText = '¡Obteniendo archivo! Generando descarga...';
          
          const a = document.createElement('a');
          a.href = data.url;
          a.download = '';
          document.body.appendChild(a);
          a.click();
          a.remove();

          statusDiv.innerText = '¡Descarga iniciada con éxito!';
        } else {
          statusDiv.innerText = 'Error: ' + (data.text || 'No se pudo procesar este enlace.');
        }
      } catch (err) {
        console.error(err);
        statusDiv.innerText = 'Ocurrió un error al conectar con el servidor de descargas.';
      }
    }
  </script>
</body>
</html>
